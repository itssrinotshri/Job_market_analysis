# ── Environment & Secrets ──────────────────────────────────────
.env
*.env.local

# ── Python Cache ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ───────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Raw API Data (large JSON dumps, regenerated by pipeline) ───
data/raw/

# ── Processed CSVs (regenerated by pipeline) ──────────────────
data/processed/

# ── IDE & OS ───────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Jupyter ────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ──────────────────────────────────────────────────────
*.log

# NOTE: data/job_market.db is INCLUDED (tracked in git)
# so Render/GitHub viewers can see real data without re-running pipeline.
